# Секреты и идентификаторы пользователя
.anonymous-user-id
codex-oauth.json
.credentials.yaml

# Рабочие данные DSH
sessions/
storages/
backup/

# Базы и временные журналы
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.log

# Установленные зависимости и сборочные артефакты
**/node_modules/
**/dist/
**/build/
**/lib/
!plugins/dsh-better-sidebar-andrew/lib
!plugins/dsh-better-sidebar-andrew/lib/
!plugins/dsh-better-sidebar-andrew/lib/**

# Better Sidebar generated browser sourcemaps
/plugins/dsh-better-sidebar-andrew/lib/*.js.map

# Локальные временные файлы инструментов
.playwright-cli/
.playwright-mcp/
_codex-backups/
.tmp/
tmp/

# Локальные настройки DSH
/settings.yaml

# Python generated cache
**/__pycache__/
**/*.pyc

# Runtime/user data
/attachments/
/change-ledger/
/profiles/web/.dsh-market/

# Launcher runtime state
/tools/deepseek-harness-launcher/dsh.pid
/tools/deepseek-harness-launcher/dsh-runtime.json

# Repository runtime logs
/runtime-logs/

# Local temporary inspection artifacts
/.tmp-*/
tmp-*.ps1

# Old extracted implementation packages
/WEB_POSTMAN_WP_*_extracted/

# Profile backup files
/profiles/web/*.bak

# Runtime-состояние Branchline
/plugins/dsh-branchline/tasks.json
/plugins/dsh-branchline/tasks.json.lock
/plugins/dsh-branchline/tasks.json.operations.lock
