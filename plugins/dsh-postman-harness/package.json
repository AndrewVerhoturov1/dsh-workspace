{
  "name": "dsh-postman-harness",
  "version": "0.1.0",
  "description": "Внутренняя почта Harness для постоянного служебного агента POSTMAN",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./bridge": "./lib/postman-bridge.js",
    "./package.json": "./package.json",
    "./client": "./dist-client/client.js"
  },
  "files": [
    "lib/index.js",
    "lib/direct-current-turn.js",
    "lib/postman-bridge.js",
    "lib/postman-bridge-core.js",
    "lib/postman-bridge-launch-coordinator.js",
    "lib/postman-bridge-jobs.js",
    "lib/postman-worker.js",
    "lib/postman-task-context.js",
    "lib/implementation-artifact.js",
    "lib/result-presentation.js",
    "lib/result-workspace.js",
    "lib/runtime.js",
    "lib/task-creation-bridge.js",
    "lib/github-task-publisher.js",
    "lib/web-worker-bridge.js",
    "lib/client.js",
    "lib/ptc-lab-panel.js",
    "lib/ptc-lab-panel.css",
    "lib/ptc-lab-browser-runtime.js",
    "dist-client",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dependencies": {
    "quickjs-emscripten": "0.32.0",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "lightningcss": "1.32.0",
    "react": "18.3.1",
    "tsdown": "0.22.2"
  },
  "scripts": {
    "build:client": "tsdown -c tsdown.config.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  }
}
