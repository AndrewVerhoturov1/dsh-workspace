+/** Paint from loaded model-attempt boundaries; never infer missing history. */
+export function requestBands(chat: ChatSnapshot): ReadonlyMap<string, 0 | 1> {
+  const boundaries: { seq: number; turn: number; step: number }[] = []
+  for (const turn of chat.timeline.turns.values()) {
+    for (const step of turn.steps) {
+      if (step.start !== undefined) boundaries.push({ seq: step.start.seq, turn: turn.turn, step: step.step })
+    }
+  }
+  for (const raw of chat.nodes.values()) {
+    const node = raw as ChatNode
+    if (node.kind !== 'model-retry') continue
+    for (const seq of node.data.startedSeqs ?? []) {
+      boundaries.push({ seq, turn: node.data.current.turn, step: node.data.current.step })
+    }
+  }
+  const ordered = [...new Map(boundaries.map(boundary => [boundary.seq, boundary])).values()]
+    .sort((left, right) => left.seq - right.seq)
+  const bands = new Map<string, 0 | 1>()
+  let index = -1
+  for (const key of chat.order) {
+    const node = chat.nodes.get(key)
+    if (node === undefined) continue
+    while (index + 1 < ordered.length && ordered[index + 1]!.seq <= node.anchorSeq) index++
+    const boundary = ordered[index]
+    if (boundary === undefined) continue
+    // A partial step must not borrow a preceding step's color. A loaded
+    // retry-started boundary can still identify its own partial attempt.
+    if (node.location.kind === 'step'
+      && (node.location.turn.turn !== boundary.turn || node.location.step.step !== boundary.step)) continue
+    bands.set(key, index % 2 === 0 ? 0 : 1)
+  }
+  return bands
+}
